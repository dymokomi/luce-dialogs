#prisma 4.0
def package "luce-dialogs" {
    str owner = "dymokomi"
    str version = "0.2.1"
    str kind = "package"
    str language = "luce-base"
    str description = "Native open and save file panels for Luce programs: macOS and Windows panels, zenity or kdialog on Linux."
    str readme = "README.md"
    str[] public = ["dialogs"]

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-std"
    }

    def dependency "luce-window" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-window"
    }

    def native "macos" {
        str[] frameworks = ["AppKit", "Foundation"]
    }

    def native "windows" {
        str[] libraries = ["comdlg32", "user32"]
    }
}
