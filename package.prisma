#prisma 4.0
def package "luce-dialogs" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "package"
    str language = "luce-base"
    str description = "Native open and save file panels for Luce programs on macOS and Windows."
    str readme = "README.md"

    def export "dialogs" {
        str module = "luce_dialogs.dialogs"
    }

    def dependency "luce-window" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-window"
    }

    def native "macos" {
        list frameworks = ["AppKit", "Foundation"]
    }

    def native "windows" {
        list libraries = ["comdlg32"]
    }
}
